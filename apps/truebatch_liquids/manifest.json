{
  "product": "truebatch_liquids",
  "database": "truebatch_liquids",
  "permissions": [
    {"code": "truebatch_liquids.master.author", "label": "Write master batch record versions"},
    {"code": "truebatch_liquids.master.check", "label": "Check a master batch record version written by another person"},
    {"code": "truebatch_liquids.master.approve", "label": "Approve a checked master batch record version (QA)"},
    {"code": "truebatch_liquids.batch.issue", "label": "Issue a batch record from an approved master version"},
    {"code": "truebatch_liquids.batch.operate", "label": "Record and sign steps of a batch as performed"},
    {"code": "truebatch_liquids.batch.check", "label": "Check steps performed by another person (second person)"},
    {"code": "truebatch_liquids.batch.supervise", "label": "Production approval of a completed batch record"},
    {"code": "truebatch_liquids.qc.approve", "label": "QC approval of the results used for release"},
    {"code": "truebatch_liquids.qa.release", "label": "QA review and release of bulk tablets"},
    {"code": "truebatch_liquids.view", "label": "View batch records and master versions"},
    {"code": "truebatch_liquids.demo.skip", "label": "Skip a running wait (demo installations only)"}
  ],
  "signon": { "backchannel_logout": "/backchannel-logout" },
  "publishes": ["batch_fact_v1", "equipment_use_v1", "deviation_note_v1", "material_use_v1"],
  "reads": { "master_data": ["equipment_v1", "instrument_v1", "room_v1", "material_v1", "product_v1"], "deviations": ["deviation_v1"], "qms": ["change_v1"], "logbook": ["equipment_status_v1"], "mms": ["lot_v1", "lot_test_v1"], "recruitment": ["training_v1"] },
  "source": { "repo": "https://github.com/maglesT/truebatch-oral-liquids", "commit": "41ebd6e089620b51a85a7bfb9ef31fae7d4106f1" }
}
