{
  "product": "lims",
  "database": "lims",
  "permissions": [
    {"code": "lims.master.author", "label": "Write method and specification versions"},
    {"code": "lims.master.check", "label": "Check a method or specification version written by another person"},
    {"code": "lims.master.approve", "label": "Approve a checked method or specification version (QA)"},
    {"code": "lims.sample.register", "label": "Register, receive, store and dispose of samples"},
    {"code": "lims.analysis.perform", "label": "Start an analysis and record and sign its steps"},
    {"code": "lims.analysis.check", "label": "Check steps performed by another person (second person)"},
    {"code": "lims.analysis.review", "label": "Review a complete analysis with its audit trail, or stop one"},
    {"code": "lims.qc.approve", "label": "QC decision on a sample (approve or reject) and its certificate of analysis"},
    {"code": "lims.oos.approve", "label": "QA approval of OOS conclusions and invalidations"},
    {"code": "lims.view", "label": "View samples, analyses, methods and specifications"},
    {"code": "lims.demo.skip", "label": "Skip a running wait (demo installations only)"}
  ],
  "signon": {"backchannel_logout": "/backchannel-logout"},
  "publishes": ["coa_v1", "result_v1", "oos_v1", "instrument_use_v1", "stability_v1", "em_v1", "trend_v1", "sample_v1"],
