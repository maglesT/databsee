{
  "product": "truebatch_injectables_packing",
  "database": "truebatch_injectables_packing",
  "permissions": [
    {"code": "truebatch_injectables_packing.master.author", "label": "Write packing master record versions"},
    {"code": "truebatch_injectables_packing.master.check", "label": "Check a packing master record version written by another person"},
    {"code": "truebatch_injectables_packing.master.approve", "label": "Approve a checked packing master record version (QA)"},
    {"code": "truebatch_injectables_packing.batch.issue", "label": "Issue a packing batch record from a released batch of filled units"},
    {"code": "truebatch_injectables_packing.batch.operate", "label": "Record and sign packing steps as performed"},
    {"code": "truebatch_injectables_packing.batch.check", "label": "Check packing steps performed by another person (second person)"},
    {"code": "truebatch_injectables_packing.batch.supervise", "label": "Production approval of a completed packing record"},
    {"code": "truebatch_injectables_packing.qc.approve", "label": "QC approval of the finished packed product (tested and complies)"},
    {"code": "truebatch_injectables_packing.qa.release", "label": "QA review and release of packed batches"},
    {"code": "truebatch_injectables_packing.view", "label": "View packing records and packing master versions"},
